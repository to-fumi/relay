ADDR=:8080
DATABASE_URL=postgres://relay:relay@localhost:5432/relay?sslmode=disable
# 32 バイト以上のランダムな文字列（例: openssl rand -base64 48）
HANDOFF_TOKEN_SECRET=change-me-change-me-change-me-change-me
HANDOFF_TOKEN_TTL=60s
# dev: 仮ログイン（Bearer dev:<email>）/ entra: Entra ID
AUTH_MODE=dev
ENTRA_TENANT_ID=
# API のアプリケーション ID（aud として検証する）
ENTRA_AUDIENCE=
ADMIN_EMAILS=
# 指定すると web/dist などの SPA を配信する
STATIC_DIR=
