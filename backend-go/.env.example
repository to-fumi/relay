ADDR=:8080
DATABASE_URL=postgres://relay:relay@localhost:5432/relay?sslmode=disable
# 32 バイト以上のランダムな文字列（例: openssl rand -base64 48）
HANDOFF_TOKEN_SECRET=change-me-change-me-change-me-change-me
HANDOFF_TOKEN_TTL=60s
# dev: 開発用ログイン（メールアドレスだけでログインする）/ oidc: Google などでログインする
AUTH_MODE=dev
# --- AUTH_MODE=oidc のとき（手順は docs/google-setup.md）---
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Google に登録したリダイレクト先と同じにする（Vite 経由なら http://localhost:5173/api/auth/callback）
OIDC_REDIRECT_URL=
# ログインできる人（カンマ区切り）。"@example.com" はそのドメインの人。AUTH_MODE=oidc では必須
ALLOWED_EMAILS=
# セッションの長さ（初期値 24h）
SESSION_TTL=24h
ADMIN_EMAILS=
# 指定すると web/dist などの SPA を配信する
STATIC_DIR=
