{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "postUpdateOptions": ["gomodTidy"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Go の開発ツール（tools/go.mod）はまとめて更新する",
      "matchFileNames": ["backend-go/tools/go.mod"],
      "groupName": "go tools"
    },
    {
      "description": "GitHub Actions はまとめて更新する",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "patch と minor の devDependencies はまとめて更新する",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "dev dependencies (non-major)"
    },
    {
      "description": "QR 読み取りのライブラリと、一緒に配信する wasm（zxing-wasm）はそろえて同時に更新する。zxing-wasm は pnpm-workspace.yaml の overrides も合わせて上げる",
      "matchPackageNames": ["@yudiel/react-qr-scanner", "barcode-detector", "zxing-wasm"],
      "groupName": "qr scanner"
    }
  ]
}
