{
  "name": "@relay/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen": "openapi-ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "biome check .",
