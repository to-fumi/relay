    "e2e": "playwright test"
  },
  "dependencies": {
    "@azure/msal-browser": "5.30.0",
    "@azure/msal-react": "5.8.3",
    "@tanstack/react-query": "5.108.2",
    "@yudiel/react-qr-scanner": "2.6.0",
    "lucide-react": "1.77.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "tailwind-merge": "3.7.1",
    "zxing-wasm": "3.1.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dependency-cruiser": "18.8.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
